# CuraLink environment template. Copy to `.env` in the repo root (git-ignored).
# Secrets are read ONLY by the backend; never prefix them with VITE_ or use them in frontend code.
# Full guide: docs/MANUAL_SETUP_CHECKLIST.md · marker index: docs/DEVELOPER_CONFIGURATION.md

# --- Mode -------------------------------------------------------------------
DEMO_MODE=true
# DATABASE_URL=sqlite:///backend/curalink_demo.db
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
COOKIE_SECURE=false

# --- A. Live hackathon demo (optional; fallbacks are labelled in the UI) ------
# CURALINK_CONFIG: ANTHROPIC_API_KEY — https://console.anthropic.com/ -> API Keys. Missing => scripted assistant.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# CURALINK_CONFIG: VISION_MODEL — defaults to ANTHROPIC_MODEL. Missing key => colour analysis ("not a medical model").
# VISION_MODEL=
# CURALINK_CONFIG: CARTESIA_API_KEY — Cartesia dashboard -> API Keys. Missing => browser speech fallback (never called Cartesia).
CARTESIA_API_KEY=
# CURALINK_CONFIG: CARTESIA_VOICE_ID — copy a voice ID from the Cartesia playground.
# CARTESIA_VOICE_ID=
# CARTESIA_VERSION=2026-08-14
# CARTESIA_TTS_MODEL=sonic-3.6
# CARTESIA_STT_MODEL=ink-whisper
ENABLE_PHOTO_OBSERVATIONS=true

# --- B. University information ------------------------------------------------
# CURALINK_CONFIG: ACADEMIC_TERM
ACADEMIC_TERM_ID=FALL-2026-DEMO
# ACADEMIC_TERM_START=      # TODO(CURALINK-MANUAL): official term start (YYYY-MM-DD) for production
# ACADEMIC_TERM_END=
# CURALINK_CONFIG: COURSE_CATALOG_SOURCE — "demo_catalog" (fictional JSON) or "none"
COURSE_CATALOG_SOURCE=demo_catalog
# CURALINK_CONFIG: UNIVERSITY_DIRECTORY — authorized connector base URL; leave empty to disable lookups
# UNIVERSITY_DIRECTORY_URL=

# --- C. Demo clinic information (fictional defaults are built in) -------------
# CURALINK_CONFIG: CLINIC_PROFILE
# CLINIC_NAME=Demo Student Health Clinic (fictional)
# CLINIC_ADDRESS=100 Example Way, West Lafayette, IN 47906 (fictional)
# CLINIC_PHONE=(555) 010-0100
# CLINIC_EMAIL=clinic@clinic.example.com

# --- D. Signatures and delivery -----------------------------------------------
# CURALINK_CONFIG: SIGNATURE_ENCRYPTION — 32-byte base64url key. Empty in demo => local key in backend/.secrets/ (git-ignored).
# SIGNATURE_ENCRYPTION_KEY=
# CURALINK_CONFIG: EMAIL_DELIVERY_MODE — only "test_inbox" is implemented; other values refuse to send.
EMAIL_DELIVERY_MODE=test_inbox
# CURALINK_CONFIG: EMAIL_SENDER
EMAIL_SENDER=no-reply@clinic.example.com
# Demo delivery never leaves these domains.
TEST_EMAIL_ALLOWLIST=example.com
