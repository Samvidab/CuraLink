# Copy to .env (git-ignored). Secrets are read ONLY by the backend; never prefix
# them with VITE_ or reference them from frontend code.

DEMO_MODE=true
# DATABASE_URL=sqlite:///backend/curalink_demo.db
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
# Demo delivery never leaves these domains.
TEST_EMAIL_ALLOWLIST=example.com
COOKIE_SECURE=false

# Optional. Without a key the assistant uses the scripted, rule-based fallback.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Optional. Without a key, voice mode falls back to the browser's built-in speech
# recognition/synthesis (where supported) and then to text.
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# CARTESIA_VERSION=2026-08-14
# CARTESIA_TTS_MODEL=sonic-3.6
# CARTESIA_STT_MODEL=ink-whisper
