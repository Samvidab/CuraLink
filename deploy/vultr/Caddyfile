# Automatic HTTPS (Let's Encrypt) for API_HOST, e.g. 203-0-113-7.sslip.io (no domain purchase needed) or your own
# api.example.com. Caddy proxies WebSockets (voice) automatically.
{$API_HOST} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Only the API, the voice WebSocket and the Convex token keys are served; everything else is 404.
	@app path /api/* /.well-known/jwks.json
	handle @app {
		reverse_proxy api:8000
	}
	handle {
		respond "Not found" 404
	}
	request_body {
		max_size 15MB
	}
}
